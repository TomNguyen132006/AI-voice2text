# Copy this file to .env and fill in your own values.
# Never commit .env (it is in .gitignore).

# Nebius Token Factory API key
# Create one at https://tokenfactory.nebius.com/project/api-keys
# OpenAI-compatible base URL: https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=

# Backend: frontend URLs allowed to call the API (comma-separated, no trailing slash)
# Local default: http://localhost:3000. Add the Vercel URL after deploying.
FRONTEND_ORIGINS=

# Transcription engine (S1-1): "local" = Parakeet on this machine's NVIDIA GPU (needs NeMo env),
# "fake" = dev only, no GPU, placeholder text with real chunk times.
TRANSCRIBE_ENGINE=local
# Parakeet model on Hugging Face (default below if empty)
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3

# Job file storage (S1-4): "local" = backend/.data/ (dev only, lost on server restart),
# "s3" = S3-compatible bucket, e.g. Nebius Object Storage (needed for the deployed backend).
STORAGE_BACKEND=local
# Optional: local folder instead of backend/.data/
STORAGE_DIR=
# s3 backend only
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Web search (S3-2): Tavily API key, create one at https://app.tavily.com
# Set SEARCH_PROVIDER=fake to run the search code without network and without a key.
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily

# Job API (Epic 9)
# Abuse limits on POST /jobs (the public server spends money on every job). These are the defaults; raise them
# only in your local .env. Restart the backend after a change.
# Largest upload the API accepts, in MB (the frontend shows the same limit: MAX_UPLOAD_MB in frontend/app/lib/api.js).
MAX_UPLOAD_MB=10
# Longest transcript accepted, in characters (HTTP 413). Audio is counted after transcription.
MAX_TRANSCRIPT_CHARS=15000
# Jobs running at the same time in this server process; more gets HTTP 429 "Server busy".
MAX_CONCURRENT_JOBS=2
# Jobs accepted per UTC day, one counter per server process (HTTP 429 over the limit).
MAX_JOBS_PER_DAY=10
# A queued/running job not saved for this many minutes is reported as an error (its server restarted or went to sleep).
STALE_JOB_MINUTES=45

# Quality limits (code defaults shown; change only to experiment)
# Terms the gap finder may send to web search, per section.
GAPS_MAX_PER_SECTION=3
# Statements per section whose sources are ALL web results; the extra ones are dropped (the terms most used in the lecture stay).
NOTES_MAX_WEB_ONLY_PER_SECTION=2
# Longest web snippet, in characters, shown to the notes writer AND to the judge (one shared value).
SNIPPET_MAX_CHARS=1000
# Slides: bullets per slide, and the characters of all bullets plus the example that still fit on a slide.
SLIDE_MAX_BULLETS=7
SLIDE_MAX_BULLET_CHARS=700
