# Copy this file to .env and fill in your own values.
# Never commit .env (it is in .gitignore).

# Nebius Token Factory API key
# Create one at https://tokenfactory.nebius.com/project/api-keys
# OpenAI-compatible base URL: https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=

# Backend: frontend URLs allowed to call the API (comma-separated, no trailing slash)
# Local default: http://localhost:3000. Add the Vercel URL after deploying.
FRONTEND_ORIGINS=

# Transcription engine (S1-1): "local" = Parakeet on this machine's NVIDIA GPU (needs NeMo env),
# "fake" = dev only, no GPU, placeholder text with real chunk times.
TRANSCRIBE_ENGINE=local
# Parakeet model on Hugging Face (default below if empty)
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
